NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/plate-count
JWT_SECRET=replace-with-at-least-32-random-characters
QR_SECRET=use-a-different-random-secret-at-least-32-characters
APP_TIME_ZONE=Asia/Kolkata
APP_BASE_URL=http://localhost:3000

# Configure an SMTP sender to enable emailed password-reset links:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required only when creating the first administrator:
ADMIN_NAME=Dining Hall Admin
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password
